# ==============================================================================
# OpenTriage Configuration
# ==============================================================================

# GitHub Personal Access Token (read-only, public repos only)
# Required to avoid hitting GitHub's 60 req/hr unauthenticated rate limit
GITHUB_TOKEN=

# Local Model Settings (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=gemma3:1b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Hosted OpenAI-Compatible Model (Optional - e.g. Groq, OpenRouter, Together, OpenAI)
HOSTED_BASE_URL=
HOSTED_API_KEY=
HOSTED_MODEL=

# Baseline Model for Evaluation Comparison (Optional)
BASELINE_BASE_URL=
BASELINE_API_KEY=
BASELINE_MODEL=

# Application Mode: "local" (uses Ollama/Lexical) or "hosted" (uses hosted endpoint)
APP_MODE=local

# Safety & Rate Limits
MAX_ITEMS_LIVE=50
RATE_LIMIT_PER_IP_PER_HOUR=30
DAILY_REQUEST_CAP=300
PORT=3000
